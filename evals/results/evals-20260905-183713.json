      "a_scurs": false,
      "scurgeri": [],
      "romana": true,
      "latenta": 5.975791692733765,
      "text": "Niciunul din așteptările tăe nu mă bucură de mine, Mara. Pleacă până nu găsesc ceva de lucru.",
      "agent": "dialog",
      "model": "qwen2.5:3b-instruct"
    },
    {
