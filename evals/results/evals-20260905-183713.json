      "potrivit": null,
      "a_scurs": false,
      "scurgeri": [],
      "romana": true,
      "latenta": 4.439969539642334,
      "text": "Nici nu-l cunosc, Mara, și nu-mi place să vorbesc cu cine nu cunosc.",
